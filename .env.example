# Configuración del Bot de Inventario (WhatsApp)
# Copia este archivo a .env y completa los valores

# === Supabase ===
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=tu-clave-supabase-anon

# === WhatsApp (Meta) ===
VERIFY_TOKEN=tu-verify-token-para-webhook
WHATSAPP_TOKEN=tu-whatsapp-token
PHONE_NUMBER_ID=tu-phone-number-id
META_APP_SECRET=tu-meta-app-secret

# === IA (elegir uno) ===

# Opción A: DeepSeek (nube - recomendado para producción)
# DEEPSEEK_API_KEY=sk-tu-clave-deepseek
# USE_OLLAMA=0

# Opción B: Ollama (local - gratuito, necesita tener Ollama instalado)
# USE_OLLAMA=1
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5-coder:7b  # Modelo grande (7B params) - requiere ~8GB RAM
# OLLAMA_MODEL=qwen2.5-coder:1.5b  # Alternativa pequeña (~2GB RAM)
