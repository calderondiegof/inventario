"""Reescribir parsing_utils.py"""
fp = r'c:\Users\Alexander Calderon\agente_inventario\inventario\utils\parsing_utils.py'

# Escribo las partes por separado para no exceder limite
content = '"""Utilidades de parsing de bloques de texto libre."""\n'
content += 'import re\n'
content += 'import hashlib\n'
content += 'from typing import Any, Dict, List, Optional\n'
content += '\n_PATRON_DOCUMENTO = re.compile(r"(?:CC|C\\.C\\.|DNI|NIT)\\s*[:.\\-]?\\s*(\\d[\\d.,-]*\\d|\\d+)", re.IGNORECASE)\n'
content += '_PATRON_CELULAR = re.compile(r"(?:Cel|Tel)\\s*[:.\\-]?\\s*(\\+?\\d[\\d\\s\\-\\(\\)]{7,})", re.IGNORECASE)\n'
content += '_PATRON_PLACA = re.compile(r"\\b([A-Z]{3}[- ]?[0-9]{3})\\b", re.IGNORECASE)\n'
content += '_PATRON_DIRECCION = re.compile(r"(?:Dir|Direccion|Domicilio)\\s*[:.\\-]?\\s*([^\\n]{5,50})", re.IGNORECASE)\n'
content += '_PATRON_NOMENCLATURA = re.compile(r"\\b(Calle|Cll|Cl|Carrera|Cra|Av|Avenida|Diagonal|Dg|Transversal|Autopista)\\b", re.IGNORECASE)\n'
content += '\n'
content += 'def _normalizar_lineas(texto):\n    return [ln.strip() for ln in (texto or "").split("\\n") if ln.strip()]\n'
content += '\n'
content += 'def _tiene_nomenclatura(linea):\n    return bool(_PATRON_NOMENCLATURA.search(linea))\n'
content += '\n'
content += 'def parsear_bloque_persona(texto):\n    from utils.text_normalizer import normalizar_placa, normalizar_digitos, extraer_placas\n    lineas = _normalizar_lineas(texto)\n    if not lineas:\n        return {"nombre": None, "identificacion": None, "telefono": None, "direccion": None, "placa": None, "placa_trailer": None}\n    resultado = {"nombre": None, "identificacion": None, "telefono": None, "direccion": None, "placa": None, "placa_trailer": None}\n    for linea in lineas:\n        m = _PATRON_DOCUMENTO.search(linea)\n        if m:\n            resultado["identificacion"] = normalizar_digitos(m.group(1))\n        m = _PATRON_CELULAR.search(linea)\n        if m:\n            resultado["telefono"] = normalizar_digitos(m.group(1))\n        m = _PATRON_PLACA.search(linea)\n        if m:\n            p1, p2 = extraer_placas(linea)\n            if p1 and not resultado["placa"]:\n                resultado["placa"] = p1\n            if p2 and not resultado["placa_trailer"]:\n                resultado["placa_trailer"] = p2\n        m = _PATRON_DIRECCION.search(linea)\n        if m and not resultado["direccion"]:\n            resultado["direccion"] = m.group(1).strip()\n    if not resultado["direccion"]:\n        for linea in lineas:\n            if _tiene_nomenclatura(linea) and "Cel" not in linea and "DNI" not in linea:\n                resultado["direccion"] = linea\n                break\n    lineas_sin_etiquetas = [l for l in lineas if not _PATRON_DOCUMENTO.search(l) and not _PATRON_CELULAR.search(l) and not _PATRON_PLACA.search(l) and l != resultado.get("direccion")]\n    if lineas_sin_etiquetas:\n        resultado["nombre"] = lineas_sin_etiquetas[0]\n    return resultado\n'

with open(fp, 'w', encoding='utf-8') as f:
    f.write(content)
print('Done. Size:', len(content))